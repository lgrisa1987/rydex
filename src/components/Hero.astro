---
import Button from "@/components/ui/Button.astro";
import CarSideIcon from "@/components/icons/CarSideIcon.astro";
---

<section id='hero' class='hero'>
  <span class='hreo_glow' aria-hidden='true'></span>
  <div class='container hero_inner'>
    <div class='hero_main'>
      <span class='eyebrow'
        ><svg
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='1.5'
          stroke='currentColor'
          class='size-6'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z'></path>
        </svg>
        Rent &bull; Drive &bull; Own
      </span>
      <h1 class='hero_title'>Drive The <br /><span class='hero_accent'>Extraordinary</span></h1>
      <p class='hero_text'>
        Premium cars for rent and hand-picked vehicles for sale. Transparent pricing, full insurance, and 24/7 support –
        from a quick weekend ride to the keys you keep forever.
      </p>
      <div class='hero_actions'>
        <Button label='Explore the Fleet' href='#fleet' arrow />
        <Button label='Cars for Sale' href='#sale' variant='ghost' />
      </div>
    </div>
    <!-- Hero marquee -->
    <div class='hero_marquee' aria-hidden='true'>
      <div class='hero_marquee_track'>
        {
          [
            "Premium Rentals",
            "Certified Sales",
            "24/7 Support",
            "Full Insurance",
            "Free Delivery",
            "Premium Rentals",
            "Certified Sales",
            "24/7 Support",
            "Full Insurance",
            "Free Delivery",
          ].map((text) => (
            <>
              <span>{text}</span>
              <CarSideIcon />
            </>
          ))
        }
      </div>
    </div>
    <!-- Hero Search -->
    <form class='hero_search' onsubmit='return false'>
      <label class='field'>
        <span
          ><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 640' class='fill-current'>
            <path
              d='M128 252.6C128 148.4 214 64 320 64C426 64 512 148.4 512 252.6C512 371.9 391.8 514.9 341.6 569.4C329.8 582.2 310.1 582.2 298.3 569.4C248.1 514.9 127.9 371.9 127.9 252.6zM320 320C355.3 320 384 291.3 384 256C384 220.7 355.3 192 320 192C284.7 192 256 220.7 256 256C256 291.3 284.7 320 320 320z'
            ></path></svg
          >
          Pick-up location
        </span>
        <select>
          {
            ["Wilmington, DE", "New York, NY", "Miami, FL", "Los Angeles, CA"].map((location) => (
              <option>{location}</option>
            ))
          }
        </select>
      </label>
      <label class='field'>
        <span>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 640' class='fill-current'>
            <path
              d='M216 64C229.3 64 240 74.7 240 88L240 128L400 128L400 88C400 74.7 410.7 64 424 64C437.3 64 448 74.7 448 88L448 128L480 128C515.3 128 544 156.7 544 192L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 192C96 156.7 124.7 128 160 128L192 128L192 88C192 74.7 202.7 64 216 64zM216 176L160 176C151.2 176 144 183.2 144 192L144 240L496 240L496 192C496 183.2 488.8 176 480 176L216 176zM144 288L144 480C144 488.8 151.2 496 160 496L480 496C488.8 496 496 488.8 496 480L496 288L144 288z'
            ></path></svg
          >
          Pick-up date</span
        >
        <input type='date' value='2026-08-25' />
      </label>
      <label class='field'>
        <span
          ><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 640' class='fill-current'>
            <path
              d='M424 64C437.3 64 448 74.7 448 88L448 128L480 128C515.3 128 544 156.7 544 192L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 192C96 156.7 124.7 128 160 128L192 128L192 88C192 74.7 202.7 64 216 64C229.3 64 240 74.7 240 88L240 128L400 128L400 88C400 74.7 410.7 64 424 64zM160 176C151.2 176 144 183.2 144 192L144 480C144 488.8 151.2 496 160 496L480 496C488.8 496 496 488.8 496 480L496 192C496 183.2 488.8 176 480 176L160 176zM390.7 241.9C398.5 231.2 413.5 228.8 424.2 236.6C434.9 244.4 437.3 259.4 429.5 270.1L307.4 438.1C303.3 443.8 296.9 447.4 289.9 447.9C282.9 448.4 276 445.9 271.1 441L215.2 385.1C205.8 375.7 205.8 360.5 215.2 351.2C224.6 341.9 239.8 341.8 249.1 351.2L285.1 387.2L390.7 242z'
            ></path></svg
          >
          Return date
        </span>
        <input type='date' value='2026-08-29' />
      </label>
      <label class='field'>
        <span
          ><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 640' class='fill-current'>
            <path
              d='M199.2 181.4L173.1 256L466.9 256L440.8 181.4C436.3 168.6 424.2 160 410.6 160L229.4 160C215.8 160 203.7 168.6 199.2 181.4zM103.6 260.8L138.8 160.3C152.3 121.8 188.6 96 229.4 96L410.6 96C451.4 96 487.7 121.8 501.2 160.3L536.4 260.8C559.6 270.4 576 293.3 576 320L576 512C576 529.7 561.7 544 544 544L512 544C494.3 544 480 529.7 480 512L480 480L160 480L160 512C160 529.7 145.7 544 128 544L96 544C78.3 544 64 529.7 64 512L64 320C64 293.3 80.4 270.4 103.6 260.8zM192 368C192 350.3 177.7 336 160 336C142.3 336 128 350.3 128 368C128 385.7 142.3 400 160 400C177.7 400 192 385.7 192 368zM480 400C497.7 400 512 385.7 512 368C512 350.3 497.7 336 480 336C462.3 336 448 350.3 448 368C448 385.7 462.3 400 480 400z'
            ></path></svg
          >Car type</span
        >
        <select>
          {["Any type", "Sedan", "SUV / Crossover", "Sports"].map((location) => <option>{location}</option>)}
        </select>
      </label>
    </form>
  </div>
</section>
