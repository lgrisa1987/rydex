---
import { cn } from "cn";

interface Props {
  label: string;
  href: string;
  arrow?: boolean;
  variant?: "accent" | "ghost";
}

const { label, href, arrow = false, variant = "accent" } = Astro.props;
---

<a href={href} class={cn("btn", variant === "ghost" ? "btn--ghost" : "btn--accent")}
  >{label}{
    arrow && (
      <svg
        xmlns='http://www.w3.org/2000/svg'
        fill='none'
        viewBox='0 0 24 24'
        stroke-width='1.5'
        stroke='currentColor'
        class='size-5'
      >
        <path stroke-linecap='round' stroke-linejoin='round' d='M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3' />
      </svg>
    )
  }</a
>
